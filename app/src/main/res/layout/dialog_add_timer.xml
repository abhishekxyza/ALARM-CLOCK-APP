<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1c1c1e"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header with title and circular close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Add Timer"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseAddTimer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_dark"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Time Pickers -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <NumberPicker
            android:id="@+id/npAddTimerHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="h"
            android:textColor="#757575"
            android:textSize="20sp"
            android:paddingHorizontal="8dp" />

        <NumberPicker
            android:id="@+id/npAddTimerMinute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="m"
            android:textColor="#757575"
            android:textSize="20sp"
            android:paddingHorizontal="8dp" />

        <NumberPicker
            android:id="@+id/npAddTimerSecond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="s"
            android:textColor="#757575"
            android:textSize="20sp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <!-- Options Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_menu_pill"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:layout_marginBottom="32dp">

        <!-- Timer Name Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Timer Name"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etTimerName"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:hint="Timer"
                android:textColor="#9E9E9E"
                android:textColorHint="#757575"
                android:gravity="end"
                android:background="@null"
                android:textSize="14sp"
                android:inputType="text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2c2c2e"
            android:layout_marginVertical="14dp" />

        <!-- Show on Lock Screen Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show on Lock Screen"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swShowOnLockScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:theme="@style/Theme.AppCompat.Light" />
        </LinearLayout>

    </LinearLayout>

    <!-- Large Orange Save Button -->
    <Button
        android:id="@+id/btnSaveAddTimer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9500" />

</LinearLayout>
