<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090b11"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivBell"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_popup_reminder"
        app:tint="#ef4444"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Alarm Active"
        android:textColor="#f8fafc"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRingingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="07:00 AM"
        android:textColor="#f8fafc"
        android:textSize="64sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRingingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Wake Up!"
        android:textColor="#94a3b8"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Snooze (5m)"
            android:textColor="#f8fafc"
            android:backgroundTint="#1e293b" />

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:text="Dismiss"
            android:textColor="#ffffff"
            android:backgroundTint="#ef4444" />
    </LinearLayout>

</LinearLayout>
