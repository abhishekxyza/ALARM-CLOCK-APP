<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090b11">

    <ImageView
        android:id="@+id/ivAnimeCharacter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4" />

    <androidx.camera.view.PreviewView
        android:id="@+id/ringingCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.3"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="#ef4444" />

        <TextView
            android:id="@+id/tvRingingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="07:00:00"
            android:textColor="#f8fafc"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRingingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Wake Up!"
            android:textColor="#94a3b8"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvTaskInstructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Scan your registered barcode to dismiss!"
            android:textColor="#6366f1"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="italic"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnSnooze"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Snooze (5m)"
                android:textColor="#f8fafc"
                android:backgroundTint="#1e293b" />

            <Button
                android:id="@+id/btnDismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:text="Dismiss"
                android:textColor="#ffffff"
                android:backgroundTint="#ef4444" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
